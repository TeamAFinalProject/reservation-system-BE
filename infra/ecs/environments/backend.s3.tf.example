terraform {
  backend "s3" {
    bucket               = "<approved-state-bucket>"
    key                  = "reservation-system/ecs/mvp/terraform.tfstate"
    region               = "ap-northeast-2"
    allowed_account_ids  = ["109729968560"]
    workspace_key_prefix = "reservation-system/ecs/mvp/workspaces"
    encrypt              = true
    use_lockfile         = true
  }
}
