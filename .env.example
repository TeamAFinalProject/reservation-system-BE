# 복사해서 .env로 사용하고, 실제 값은 커밋하지 않습니다.
DB_URL=jdbc:postgresql://localhost:5432/reservation
DB_USERNAME=
DB_PASSWORD=

# Local Valkey. Export these for Gradle or configure them in the IDE.
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_TLS=false
AUTH_IDLE_TIMEOUT=30m
AUTH_ABSOLUTE_TIMEOUT=12h
# CORS_ALLOWED_ORIGINS=https://frontend.example.test
